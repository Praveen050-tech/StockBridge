// Prisma Schema for StockBridge B2B Godown & Shop Stock Logistics Network
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  shop_owner
  godown_admin
}

enum OrderStatus {
  pending
  approved
  partially_fulfilled
  dispatched
  delivered
  rejected
}

enum MovementType {
  restock_in
  dispatch_out
  sale
  adjustment
  damage
  voice_correction
}

model User {
  id                 Int          @id @default(autoincrement())
  name               String       @db.VarChar(120)
  phone              String       @unique @db.VarChar(20)
  email              String       @unique @db.VarChar(120)
  password_hash      String       @db.VarChar(255)
  role               Role         @default(shop_owner)
  godown_id          Int?         // If shop_owner, linked godown to order from
  preferred_language String       @default("en-IN") @db.VarChar(10)
  created_at         DateTime     @default(now())

  // Relations
  linked_godown       Godown?         @relation("ShopLinkedGodown", fields: [godown_id], references: [id], onDelete: SetNull)
  administered_godown Godown?         @relation("GodownAdmin")
  shop_stocks         ShopStock[]
  orders              Order[]         @relation("ShopOrders")
  stock_movements     StockMovement[] @relation("ShopMovements")
  voice_logs          VoiceLog[]

  @@index([godown_id])
  @@map("users")
}

model Godown {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(150)
  location      String          @db.VarChar(255)
  admin_user_id Int             @unique
  created_at    DateTime        @default(now())

  // Relations
  admin         User            @relation("GodownAdmin", fields: [admin_user_id], references: [id], onDelete: Cascade)
  linked_shops  User[]          @relation("ShopLinkedGodown")
  products      Product[]
  godown_stocks GodownStock[]
  orders        Order[]
  stock_movements StockMovement[]

  @@map("godowns")
}

model Product {
  id             Int             @id @default(autoincrement())
  godown_id      Int
  name           String          @db.VarChar(150)
  aliases        String?         @db.Text
  category       String          @db.VarChar(100)
  unit           String          @db.VarChar(30) // kg, l, pcs, box, packet
  price_per_unit Decimal         @db.Decimal(10, 2)
  created_at     DateTime        @default(now())

  // Relations
  godown         Godown          @relation(fields: [godown_id], references: [id], onDelete: Cascade)
  godown_stock   GodownStock?
  shop_stocks    ShopStock[]
  order_items    OrderItem[]
  stock_movements StockMovement[]

  @@index([godown_id])
  @@map("products")
}

model GodownStock {
  id                 Int       @id @default(autoincrement())
  product_id         Int       @unique
  godown_id          Int
  quantity_available Decimal   @default(0.00) @db.Decimal(12, 2)
  last_updated       DateTime  @updatedAt

  // Relations
  product            Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  godown             Godown    @relation(fields: [godown_id], references: [id], onDelete: Cascade)

  @@index([godown_id])
  @@map("godown_stock")
}

model ShopStock {
  id                Int       @id @default(autoincrement())
  shop_user_id      Int
  product_id        Int
  quantity_on_hand  Decimal   @default(0.00) @db.Decimal(12, 2)
  reorder_threshold Decimal   @default(10.00) @db.Decimal(12, 2)
  last_updated      DateTime  @updatedAt

  // Relations
  shop_user         User      @relation(fields: [shop_user_id], references: [id], onDelete: Cascade)
  product           Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([shop_user_id, product_id])
  @@index([shop_user_id])
  @@index([product_id])
  @@map("shop_stock")
}

model Order {
  id             Int         @id @default(autoincrement())
  shop_user_id   Int
  godown_id      Int
  status         OrderStatus @default(pending)
  total_amount   Decimal     @default(0.00) @db.Decimal(12, 2)
  source         String      @default("manual") @db.VarChar(50)
  raw_transcript String?     @db.Text
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  // Relations
  shop_user        User            @relation("ShopOrders", fields: [shop_user_id], references: [id], onDelete: Cascade)
  godown           Godown          @relation(fields: [godown_id], references: [id], onDelete: Cascade)
  items            OrderItem[]
  stock_movements  StockMovement[]

  @@index([shop_user_id])
  @@index([godown_id])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  order_id      Int
  product_id    Int
  qty_requested Decimal  @db.Decimal(12, 2)
  qty_fulfilled Decimal  @default(0.00) @db.Decimal(12, 2)
  unit_price    Decimal  @db.Decimal(10, 2)

  // Relations
  order         Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

model StockMovement {
  id                 Int          @id @default(autoincrement())
  product_id         Int
  godown_id          Int?
  shop_user_id       Int?
  movement_type      MovementType
  quantity           Decimal      @db.Decimal(12, 2) // Positive or recorded delta
  reference_order_id Int?
  raw_transcript     String?      @db.Text
  created_at         DateTime     @default(now())

  // Relations
  product            Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)
  godown             Godown?      @relation(fields: [godown_id], references: [id], onDelete: SetNull)
  shop_user          User?        @relation("ShopMovements", fields: [shop_user_id], references: [id], onDelete: SetNull)
  reference_order    Order?       @relation(fields: [reference_order_id], references: [id], onDelete: SetNull)

  @@index([product_id])
  @@index([godown_id])
  @@index([shop_user_id])
  @@index([reference_order_id])
  @@map("stock_movements")
}

model VoiceLog {
  id                 Int          @id @default(autoincrement())
  user_id            Int
  raw_transcript     String       @db.Text
  detected_intent    String       @db.VarChar(100)
  detected_language  String       @db.VarChar(20)
  confidence         Decimal      @db.Decimal(5, 4)
  action_taken       String?      @db.Text
  created_at         DateTime     @default(now())

  user               User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("voice_logs")
}
